# URL absolue du backend déployé (Render), SANS suffixe /api — les routes
# du backend sont montées à la racine (/listings, /auth, /users...), le
# proxy Vite local (vite.config.js) retire déjà le préfixe /api en dev.
# Laisser vide en local pour utiliser ce proxy.
VITE_API_URL="https://troc-backend.onrender.com"

# Même backend, pour la connexion Socket.io (messagerie temps réel).
VITE_SOCKET_URL="https://troc-backend.onrender.com"
