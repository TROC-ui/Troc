NODE_ENV=production
PORT=3000

# PostgreSQL — récupère cette URL depuis Supabase ou Neon (plan gratuit).
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# JWT — génère un secret fort et unique pour la prod, jamais celui du dev.
# Exemple pour en générer un : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-strong-random-secret"

# URL du frontend déployé (Vercel) — utilisée pour CORS et pour générer les
# liens de réinitialisation de mot de passe.
FRONTEND_URL="https://troc.vercel.app"

# Cloudinary (optionnel, pour le stockage d'images réel)
CLOUDINARY_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SendGrid (optionnel, pour l'envoi d'emails réel — mot de passe oublié, etc.)
SENDGRID_API_KEY=""
